--cpu Cortex-M3
"sv2\startup_stm32f103xb.o"
"sv2\fault_injection.o"
"sv2\main.o"
"sv2\gpio.o"
"sv2\iwdg.o"
"sv2\tim.o"
"sv2\stm32f1xx_it.o"
"sv2\stm32f1xx_hal_msp.o"
"sv2\stm32f1xx_hal_gpio_ex.o"
"sv2\stm32f1xx_hal_iwdg.o"
"sv2\stm32f1xx_hal.o"
"sv2\stm32f1xx_hal_rcc.o"
"sv2\stm32f1xx_hal_rcc_ex.o"
"sv2\stm32f1xx_hal_gpio.o"
"sv2\stm32f1xx_hal_dma.o"
"sv2\stm32f1xx_hal_cortex.o"
"sv2\stm32f1xx_hal_pwr.o"
"sv2\stm32f1xx_hal_flash.o"
"sv2\stm32f1xx_hal_flash_ex.o"
"sv2\stm32f1xx_hal_exti.o"
