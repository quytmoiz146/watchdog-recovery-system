--cpu Cortex-M3
"watchdog-system\startup_stm32f103xb.o"
"watchdog-system\main.o"
"watchdog-system\system_status.o"
"watchdog-system\temp_sensor.o"
"watchdog-system\stm32f1xx_it.o"
"watchdog-system\stm32f1xx_hal_msp.o"
"watchdog-system\stm32f1xx_hal_gpio_ex.o"
"watchdog-system\stm32f1xx_hal_i2c.o"
"watchdog-system\stm32f1xx_hal.o"
"watchdog-system\stm32f1xx_hal_rcc.o"
"watchdog-system\stm32f1xx_hal_rcc_ex.o"
"watchdog-system\stm32f1xx_hal_gpio.o"
"watchdog-system\stm32f1xx_hal_dma.o"
"watchdog-system\stm32f1xx_hal_cortex.o"
"watchdog-system\stm32f1xx_hal_pwr.o"
"watchdog-system\stm32f1xx_hal_flash.o"
"watchdog-system\stm32f1xx_hal_flash_ex.o"
"watchdog-system\stm32f1xx_hal_exti.o"
"watchdog-system\stm32f1xx_hal_iwdg.o"
